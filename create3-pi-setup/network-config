## Reference network-config — example of what prep-sd-card.sh produces.
##
## prep-sd-card.sh no longer copies this file directly; it does a YAML merge
## of the existing network-config (whatever the Pi Imager wrote, including
## Wi-Fi creds) with the usb0 entry below. This file is here as a reference
## for what a fully-configured network-config looks like.
##
## Required for Create 3 connectivity: the usb0 entry sets a static IP on
## the USB-C link to the Create 3 robot. The Create 3 itself uses 192.168.186.2
## on its end. Don't change those addresses.
##
## Wi-Fi is optional. Uncomment and edit the wifis section, OR leave it
## commented and use ethernet (or set Wi-Fi via the Imager's GUI before
## you copy this file over — Imager's settings get baked into a sibling
## file and our usb0 stanza gets merged in).

version: 2

ethernets:
  eth0:
    dhcp4: true
    optional: true

  # USB-C link to the Create 3 robot. DO NOT change the IP — Create 3
  # expects 192.168.186.2 on its end and this Pi on .3.
  usb0:
    dhcp4: false
    optional: true
    addresses: [192.168.186.3/24]

# Uncomment and edit if you want Wi-Fi configured at first boot.
